{
  "name": "m5ls5e.com",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build": "npx vite build",
    "clean": "rm -rf dist",
    "format": "npx oxfmt src",
    "format:check": "npx oxfmt --check src",
    "lint": "npx oxlint src",
    "prebuild": "npm run clean",
    "preview": "npx vite preview",
    "start": "npx wrangler pages dev -- npx vite serve",
    "test": "npm run format:check && npm run lint"
  },
  "author": {
    "name": "Michael Sprague",
    "email": "mikesprague@gmail.com"
  },
  "repository": {
    "url": "https://github.com/mikesprague/m5ls5e-com"
  },
  "engines": {
    "node": ">= 26",
    "npm": ">= 11"
  },
  "packageManager": "npm@12.0.2",
  "license": "MIT",
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/fontawesome-svg-core": "7.3.1",
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "bulma": "1.0.4",
    "cz-git": "1.14.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "vite": "8.2.2",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4"
  },
  "browserslist": {
    "development": [
      "last 1 version"
    ],
    "production": [
      "> 1%",
      "last 2 versions",
      "not ie <= 10"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260908.1": true
  }
}
